# 前端（Vite）环境变量。复制为 .env，切勿提交。
# 后端的环境变量在 backend/growth-api/.env.example

# 留空表示同源。开发环境 vite 已把 /api 代理到本地后端，不需要填。
VITE_API_BASE_URL=

# 认证已接通真实后端
VITE_AUTH_MODE=real

# 品牌 / 素材 / 知识 / 作品等模块后端尚未实现，暂时返回演示数据。
# 对应模块接通后改为 false。
VITE_DEMO_MODE=true

# 后端不在 8080 时改这个（仅开发代理用）
VITE_DEV_API_TARGET=http://localhost:8080
