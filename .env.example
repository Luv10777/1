# 前端（Vite）环境变量。复制为 .env，切勿提交。
# 后端的环境变量在 backend/growth-api/.env.example

# 留空表示同源。开发环境 vite 已把 /api 代理到本地后端，不需要填。
VITE_API_BASE_URL=

# 认证已接通真实后端
VITE_AUTH_MODE=real

# 品牌 / 作品等其他模块仍使用演示数据；门店选择、商品库、FAQ 和直播配置始终调用真实 API。
# 对应模块接通后改为 false。
VITE_DEMO_MODE=true

# 本轮后端默认运行于 18080（仅开发代理用）
VITE_DEV_API_TARGET=http://localhost:18080

# 可选：密码登录接口路径（必须以 /api/ 开头）。留空使用 /api/auth/password-login。
# POST { account, password }，响应 data 与 /api/auth/login 的 TokenPair 一致。
VITE_PASSWORD_LOGIN_ENDPOINT=

# 可选：服务端微信登录入口 URL。服务端负责 OAuth state、扫码/网页授权、回调及会话建立。
# 使用 HTTPS 或同源相对路径；不要在前端配置 AppSecret 或固定的 OAuth state。
VITE_WECHAT_LOGIN_URL=

# 正式协议全文地址。留空时展示未发布提示，不生成替代法律条款。
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# 桌面端（Windows）安装包的下载地址，例如 https://yifangzhi.com/downloads/yifangzhi-setup-0.1.0.exe。
# 配置后，AI 实景直播“启动直播”一步会出现下载和“打开桌面端”的入口；留空则不出现。
VITE_DESKTOP_DOWNLOAD_URL=
