# 梧曜星枢服务端环境变量示例
# 复制此文件为 .env 并填写真实值，不要提交 .env 到Git

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/wuyao_nexus
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgres_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret (生成方式: openssl rand -base64 64)
JWT_SECRET=your_jwt_secret_at_least_64_characters_long_for_production_use

# SMS Provider (console | aliyun | tencent)
SMS_PROVIDER=console

# Aliyun SMS (仅在 SMS_PROVIDER=aliyun 时需要)
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
