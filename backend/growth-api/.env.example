# 本地开发专用。复制为 .env 后填写 JWT_SECRET；从本目录启动时自动加载。
# 使用 properties 语法，值不要包引号。生产用环境变量覆盖，不使用下面的本地密码。
DB_URL=jdbc:postgresql://localhost:5432/wuyao_growth
DB_USER=growth_app
DB_PASSWORD=growth_dev_local
DB_MIGRATE_USER=growth_owner
DB_MIGRATE_PASSWORD=growth_dev_local

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 至少 32 字节随机串：openssl rand -base64 48
JWT_SECRET=

# console 仅在后端日志显示验证码；完成阿里云配置后改为 aliyun 并重启后端。
SMS_PROVIDER=console
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
# 已审核通过的验证码模板编号；模板变量必须为 ${code}，有效期写 5 分钟。
ALIYUN_SMS_TEMPLATE_CODE=

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=growth-assets

# api 进程 false / worker 进程 true
WORKER_ENABLED=false
# New API: base URL may end in /v1. Keep the token server-side, loaded by both API and worker.
NEW_API_BASE_URL=https://myrouter.online/v1
NEW_API_API_KEY=
IMAGE_GENERATOR_PROTOCOL=OPENAI
# Optional full endpoint overrides; leave blank to derive them from NEW_API_BASE_URL.
IMAGE_PLANNER_URL=
IMAGE_PLANNER_MODEL=deepseek-v4-flash
# Image planning and prompt refinement share one Claude Sonnet call.
IMAGE_PLANNER_ALIAS=TEXT_REFINER
IMAGE_REFINER_ENABLED=true
IMAGE_REFINER_MODEL=claude-sonnet-4-6-ab
IMAGE_REFINER_TEMPERATURE=0.5
IMAGE_REFINER_MAX_TOKENS=3000
IMAGE_REFINER_TIMEOUT_SECONDS=300
# Set IMAGE_REFINER_URL / IMAGE_REFINER_API_KEY if not using shared NEW_API settings.
# Disable refinement with IMAGE_REFINER_ENABLED=false; no code edits are needed.
IMAGE_GENERATOR_URL=
IMAGE_GENERATOR_EDITS_URL=
IMAGE_GENERATOR_MODEL=gpt-image-2
# Synchronous relay response timeout for the image worker (seconds).
IMAGE_GENERATOR_TIMEOUT_SECONDS=900
# Optional separate credentials: IMAGE_PLANNER_API_KEY / IMAGE_GENERATOR_API_KEY.
# Do not define them as empty if using the shared NEW_API_API_KEY.
IMAGE_GENERATOR_QUALITY=high
# Leave blank unless the configured image endpoint requires a response_format value.
IMAGE_GENERATOR_RESPONSE_FORMAT=
# HTTPS subdomains of aliyuncs.com are allowed; add exact origins for custom CDN hosts.
# For OnlyRouter Files API content URLs, also include https://api.onlyrouter.ai.
IMAGE_DOWNLOAD_ALLOWED_ORIGINS=*.aliyuncs.com
IMAGE_TIMEOUT_SECONDS=300
IMAGE_SUPPORTED_QUALITIES=480P,720P,1080P,4K
# Optional proxy-tested output cap, e.g. 1600000. 0 leaves model dimensions unrestricted.
IMAGE_MAX_OUTPUT_PIXELS=0
# Windows: Microsoft YaHei; Linux: install Noto Sans CJK SC and set IMAGE_FONT accordingly.
IMAGE_FONT=Microsoft YaHei

# 租户并发限流配置
IMAGE_TENANT_MAX_CONCURRENT=20
# 所有租户共享的图片生成并发上限
IMAGE_GLOBAL_MAX_CONCURRENT=200
# 所有 Worker 共享的图片模型速率限制 (请求/秒，依赖 Redis)
IMAGE_API_RATE_LIMIT=100
# API 限流超时时间 (秒)
IMAGE_API_TIMEOUT=10
IMAGE_UPLOAD_MAX_PIXELS=50000000
IMAGE_CREATION_LOCK_WAIT_SECONDS=5
IMAGE_CREATION_LOCK_LEASE_SECONDS=120

# HTTP 客户端连接池配置
HTTP_MAX_TOTAL=200
HTTP_MAX_PER_ROUTE=50
HTTP_CONNECTION_TIMEOUT=15
HTTP_SOCKET_TIMEOUT=300
