# 本地开发专用。复制为 .env 后填写 JWT_SECRET；从本目录启动时自动加载。
# 使用 properties 语法，值不要包引号。生产用环境变量覆盖，不使用下面的本地密码。
POSTGRES_PORT=35432
DB_URL=jdbc:postgresql://localhost:35432/wuyao_growth
DB_USER=growth_app
DB_PASSWORD=growth_dev_local
DB_MIGRATE_USER=growth_owner
DB_MIGRATE_PASSWORD=growth_dev_local

REDIS_HOST=localhost
REDIS_PORT=36379
REDIS_PASSWORD=

# Only set actual reverse-proxy addresses. Direct requests ignore X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
SMS_PER_IP_PER_MINUTE=5
SMS_PER_IP_PER_DAY=100
SMS_GLOBAL_PER_MINUTE=100
SMS_GLOBAL_PER_DAY=10000

# 至少 32 字节随机串：openssl rand -base64 48
JWT_SECRET=

# console 仅在后端日志显示验证码；完成阿里云配置后改为 aliyun 并重启后端。
SMS_PROVIDER=console
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
# 已审核通过的验证码模板编号；模板变量必须为 ${code}，有效期写 5 分钟。
ALIYUN_SMS_TEMPLATE_CODE=

MINIO_PORT=39000
MINIO_CONSOLE_PORT=39001
MINIO_ENDPOINT=http://localhost:39000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=growth-assets

# 声音样本选 cos 后直传腾讯云；旧样本和其他素材仍使用原 MinIO。
VOICE_SAMPLE_STORAGE=minio
COS_REGION=ap-shanghai
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=

# api 进程 false / worker 进程 true。
# 直播的话术生成和语音合成都是后台任务：没有 worker 在跑，播报会一直停在“正在合成”。
# 本地只起一个进程时设为 true 即可；分开部署时 worker 的队列要包含 LIVE。
WORKER_ENABLED=false
SERVER_PORT=18080

# 语音 API 仅在服务端配置。复制供应商控制台中当前工作空间的北京地域地址。
# 未配置时仍可保存样本、配对播报端和播放接线测试音，不会伪造克隆结果。
DASHSCOPE_API_KEY=
DASHSCOPE_CLONE_URL=
DASHSCOPE_WEBSOCKET_URL=
DASHSCOPE_TTS_MODEL=cosyvoice-v3.5-flash
# 使用创建返回的 voice_id 合成；只有确认支持当前模型时才配置系统音色。
DASHSCOPE_BUILTIN_VOICE=
# 托管克隆要求样本的预签名 HTTPS 地址可由供应商访问，本地 localhost MinIO 不可用。

# 文案模型（直播自动讲解用它写话术）。任何 OpenAI 兼容的 chat completions 接口，填完整地址。
# 三项缺任何一项即视为未配置，自动讲解会明确报错，不会用占位内容顶替。
# 例：阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions，模型 qwen-plus
TEXT_WRITER_URL=
TEXT_WRITER_API_KEY=
TEXT_WRITER_MODEL=
# 原样并入请求体的 JSON。默认开启思考的模型（如通义千问 3.x）写一段口播要 25 秒以上，
# 关掉后约 4 秒，直播场景应当关闭：{"enable_thinking":false}
TEXT_WRITER_EXTRA_BODY=
# 判断弹幕要不要回、该怎么回时额外并入请求体的 JSON：这一步宁可慢几秒也要想清楚。
# 通义千问填 {"enable_thinking":true}；留空则和写口播一样不思考。
TEXT_WRITER_REASONING_EXTRA_BODY=
# 直播里不回答、也不让 AI 说出来的词，逗号分隔（竞品名等）。辱骂和站外引流已内置。
LIVE_BLOCKED_TERMS=
WORKER_PARALLELISM=1
# New API: base URL may end in /v1. Keep the token server-side, loaded by both API and worker.
NEW_API_BASE_URL=https://myrouter.online/v1
NEW_API_API_KEY=
IMAGE_GENERATOR_PROTOCOL=OPENAI
# The only text layer understands the request, plans the series, and writes final image prompts.
IMAGE_TEXT_URL=https://api.onlyrouter.ai/v1/chat/completions
IMAGE_TEXT_MODEL=gpt-6-luna
IMAGE_TEXT_API_KEY=
IMAGE_TEXT_TEMPERATURE=0.5
IMAGE_TEXT_MAX_TOKENS=6000
IMAGE_TEXT_TIMEOUT_SECONDS=300
IMAGE_GENERATOR_URL=https://new.fluapi.com/v1/images/generations
IMAGE_GENERATOR_EDITS_URL=
IMAGE_GENERATOR_MODEL=gpt-image-2.5-ultra-fast
# Flu response timeout for the image worker (seconds).
IMAGE_GENERATOR_TIMEOUT_SECONDS=600
# Optional separate credentials: IMAGE_TEXT_API_KEY / IMAGE_GENERATOR_API_KEY.
# Do not define them as empty if using the shared NEW_API_API_KEY.
IMAGE_GENERATOR_QUALITY=standard
# Leave blank unless the configured image endpoint requires a response_format value.
IMAGE_GENERATOR_RESPONSE_FORMAT=url
# HTTPS subdomains of aliyuncs.com are allowed; add exact origins for custom CDN hosts.
# For OnlyRouter Files API, allow both https://api.onlyrouter.ai and the actual signed-download origin.
IMAGE_DOWNLOAD_ALLOWED_ORIGINS=*.aliyuncs.com
IMAGE_TIMEOUT_SECONDS=300
IMAGE_SUPPORTED_QUALITIES=1K,2K,4K
# Optional proxy-tested output cap, e.g. 1600000. 0 leaves model dimensions unrestricted.
IMAGE_MAX_OUTPUT_PIXELS=0
# Windows: Microsoft YaHei; Linux: install Noto Sans CJK SC and set IMAGE_FONT accordingly.
IMAGE_FONT=Microsoft YaHei

# 租户并发限流配置
IMAGE_TENANT_MAX_CONCURRENT=20
# 所有租户共享的图片生成并发上限
IMAGE_GLOBAL_MAX_CONCURRENT=200
# 所有 Worker 共享的图片模型速率限制 (请求/秒，依赖 Redis)
IMAGE_API_RATE_LIMIT=100
# API 限流超时时间 (秒)
IMAGE_API_TIMEOUT=10
IMAGE_UPLOAD_MAX_PIXELS=50000000
IMAGE_CREATION_LOCK_WAIT_SECONDS=5
IMAGE_CREATION_LOCK_LEASE_SECONDS=120

# 异步视频供应商：提交返回任务 ID，轮询完成后返回视频 URL
VIDEO_PROVIDER_NAME=onlyrouter
VIDEO_PROVIDER_PROTOCOL=CHAT_COMPLETIONS
VIDEO_PROVIDER_BASE_URL=https://api.onlyrouter.ai
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_SUBMIT_PATH=/v1/videos
VIDEO_PROVIDER_POLL_PATH=/v1/videos/{jobId}
VIDEO_PROVIDER_CONTENT_PATH=/v1/videos/{jobId}/content
VIDEO_PROVIDER_TIMEOUT_SECONDS=60
VIDEO_TENANT_MAX_CONCURRENT=2
VIDEO_GLOBAL_MAX_CONCURRENT=20
VIDEO_CONCURRENCY_PERMIT_TTL_SECONDS=21600
VIDEO_MAX_POLLS=360
VIDEO_MAX_DURATION_SECONDS=7200
# 超过 pending 阈值或存在阶段超时工作流时，video health 返回 DOWN。
VIDEO_HEALTH_PROVIDER_PENDING_THRESHOLD=100
VIDEO_HEALTH_MEDIA_PENDING_THRESHOLD=20
# 未配置时跟随 VIDEO_MAX_DURATION_SECONDS；阶段年龄包含排队/退避/轮询等待。
VIDEO_HEALTH_STUCK_AFTER_SECONDS=7200
VIDEO_HEALTH_STUCK_WORKFLOWS_THRESHOLD=0
VIDEO_HEALTH_SNAPSHOT_CACHE_SECONDS=15
# 签名 TTL 至少覆盖处理时限 + max(安全余量, 供应商超时 + 25 秒)，最大 604800 秒。
VIDEO_REFERENCE_PRESIGN_TTL_SECONDS=21600
VIDEO_REFERENCE_URL_SAFETY_SECONDS=300
VIDEO_MAX_PROVIDER_BYTES=1073741824
VIDEO_REFERENCE_MAX_BYTES=524288000
VIDEO_REFERENCE_MAX_DURATION_SECONDS=300
VIDEO_REFERENCE_MAX_WIDTH=4096
VIDEO_REFERENCE_MAX_HEIGHT=4096
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

# 视频反推：服务端抽帧，一次多图请求。API 与 MEDIA_CPU / DEFAULT worker 使用同一配置。
VIDEO_ANALYSIS_BASE_URL=https://api.onlyrouter.ai/v1
VIDEO_ANALYSIS_MODEL=gpt-6-luna
# Optional Windows JDK workaround: org.apache.coyote.http11.Http11Nio2Protocol
SERVER_PROTOCOL=
# Use jedis on Windows JDKs where the default NIO selector cannot connect locally.
REDIS_CLIENT_TYPE=lettuce
VIDEO_ANALYSIS_API_KEY=
VIDEO_ANALYSIS_MAX_BYTES=104857600
VIDEO_ANALYSIS_MAX_DURATION_SECONDS=60
VIDEO_ANALYSIS_MAX_FRAMES=48
VIDEO_ANALYSIS_FRAME_LONG_EDGE=1280
VIDEO_ANALYSIS_FPS=2
VIDEO_ANALYSIS_TIMEOUT_SECONDS=180
VIDEO_ANALYSIS_MAX_TOKENS=12000
# 独立音频理解模型；三项配置齐全后自动启用。纯转录模型无法分析配乐与音效。
VIDEO_ANALYSIS_AUDIO_BASE_URL=
VIDEO_ANALYSIS_AUDIO_API_KEY=
VIDEO_ANALYSIS_AUDIO_MODEL=
# Qwen-Omni 使用 DATA_URL；要求裸 Base64 的音频接口使用 BASE64。
VIDEO_ANALYSIS_AUDIO_INPUT_ENCODING=DATA_URL
VIDEO_ANALYSIS_AUDIO_TIMEOUT_SECONDS=120
VIDEO_ANALYSIS_AUDIO_MAX_TOKENS=4000
# growth.video.poll-seconds：轮询基础间隔（秒）；按轮次放大，最低 5 秒、最高 60 秒。
# 提交后的首次查询立即入队；默认基础间隔仍为 15 秒。
VIDEO_POLL_SECONDS=15
VIDEO_MODEL_SEEDANCE_2_5=doubao-seedance-2-5-260628
VIDEO_MODEL_SEEDANCE_2_0=doubao-seedance-2-0-260128
VIDEO_MODEL_SEEDANCE_2_0_MINI=doubao-seedance-2-0-mini-260615
VIDEO_MODEL_SEEDANCE_2_0_FAST=doubao-seedance-2-0-fast-260128

# HTTP 客户端连接池配置
HTTP_MAX_TOTAL=200
HTTP_MAX_PER_ROUTE=50
HTTP_CONNECTION_TIMEOUT=15
HTTP_SOCKET_TIMEOUT=300
