# 测试服务器配置。复制为 deploy/.env 后填写。
# deploy/.env 已在 .gitignore 里，不会提交。

# ---- 对外端口 ----
# 域名未备案时，境内服务器用非标端口 + IP 直连访问
WEB_PORT=8000
# 管理后台单独服务，仅绑定服务器本机；默认通过 SSH 隧道或独立 HTTPS 域名反代。
ADMIN_HTTP_PORT=18081
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- 数据库 ----
DB_NAME=wuyao_growth
# owner 负责建表和跑迁移
DB_OWNER_USER=growth_owner
DB_OWNER_PASSWORD=
# app 是应用连接用的受限角色，受行级安全约束。V1 迁移会用这个口令创建它
DB_APP_USER=growth_app
DB_APP_PASSWORD=

# ---- Redis ----
REDIS_PASSWORD=

# ---- JWT ----
# 生成：openssl rand -base64 48
# 换掉它会让所有人被登出，定下来就别动，并且备份好
JWT_SECRET=

# ---- 监控（可选，开 --profile monitoring 时才需要）----
# Prometheus 读后端指标用的口令：openssl rand -hex 32
METRICS_TOKEN=
# Grafana 管理员 admin 的密码：openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000

# ---- 对象存储 ----
MINIO_USER=growth
MINIO_PASSWORD=
MINIO_BUCKET=growth-assets
# 必须是浏览器能访问到的地址，不能写 http://minio:9000
# 换成你服务器的公网 IP
MINIO_PUBLIC_ENDPOINT=http://1.2.3.4:9000

# ---- CORS ----
# 前端和后端同源（都走 nginx），一般不用改。用独立域名时填在这里
CORS_ORIGINS=http://1.2.3.4:8000

# 微信网站应用扫码登录（AppSecret 只放在服务器环境变量，不提交到 Git）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_URL=https://yifangzhi.com/api/auth/wechat/callback
WECHAT_FRONTEND_LOGIN_PATH=/login

# 平台运营账号 ID，多个用逗号分隔；商家管理员不会自动获得平台审核权限。
PLATFORM_OPERATOR_USER_IDS=
# 实名字段加密密钥：openssl rand -base64 32。请安全备份，已有数据时不可直接换新。
REAL_NAME_ENCRYPTION_KEY=

# 微信支付 API v3 Native。私钥和平台公钥以文件挂载，不提交到仓库。
BILLING_OPERATOR_USER_IDS=
WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_KEY_ID=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
# 支付宝电脑网站支付（公钥模式）。BILLING_PAYMENT_METHOD=ALIPAY 时启用；私钥和支付宝公钥以文件提供。
BILLING_PAYMENT_METHOD=WECHAT
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_NOTIFY_URL=
# 商城自动支付仅面向指定收款店铺；复用以上支付宝配置和 /api/billing/alipay/notify 回调。
COMMERCE_ALIPAY_STORE_ID=5
COMMERCE_ALIPAY_RECIPIENT=嘉兴市梧曜科技有限公司
# 容器内路径，例如 file:/etc/wuyao/billing-rates.yml；API 与 worker 必须一致。
SPRING_CONFIG_ADDITIONAL_LOCATION=
# 配置文件目录的宿主机路径；目录包含私钥、公钥及费率 YAML，仅服务进程可读。
BILLING_CONFIG_DIR=./billing-config
